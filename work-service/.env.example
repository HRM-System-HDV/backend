PORT=4003
NODE_ENV=development
SERVICE_NAME=work-service

# Mặc định local: 5 Postgres riêng do `docker compose up -d` dựng (mỗi service 1 container/port).
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/hrm_work
# Nếu dùng Supabase: mỗi service phải dùng 1 project/link RIÊNG (cấm trỏ 2 service cùng 1 link).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true

CORS_ORIGIN=http://localhost:3000
# Giao tiếp nội bộ qua HTTP, timeout 5000ms; dùng cùng token cho các service.
INTERNAL_API_TOKEN=dev_only_internal_token_thay_khi_deploy
ORGANIZATION_SERVICE_URL=http://localhost:4002
IDENTITY_SERVICE_URL=http://localhost:4001
INTEGRATION_SERVICE_URL=http://localhost:4005
