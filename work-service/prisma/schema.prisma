// Prisma schema — work-service
// DB riêng hrm_work (single-tenant, không có tenantId).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shift {
  id             String   @id @default(cuid())
  employeeId     String
  branchSlug     String?
  date           String
  template       String?
  scheduledStart String?
  scheduledEnd   String?
  checkIn        String?
  checkOut       String?
  status         String   @default("Chưa chấm công")
  note           String?
  isRecurring    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("shifts")
}

model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  shiftId       String?
  date          String
  checkIn       String?
  checkOut      String?
  penaltyAmount Float    @default(0)
  penaltyNote   String?
  status        String   @default("present")
  createdAt     DateTime @default(now())

  @@map("attendances")
}

model AttendanceConfig {
  id                      String @id @default("default")
  latePenaltyAmount       Int    @default(20000)
  earlyLeavePenaltyAmount Int    @default(0)
  gracePeriodMinutes      Int    @default(5)
  checkoutWindowMinutes   Int    @default(60)
  autoCloseShift          Boolean @default(false)
  shiftSwapMode           String @default("manual")
  latePenaltyPct          Int    @default(10)
  earlyLeavePenaltyPct    Int    @default(10)
  earlyCheckinMinutes     Int    @default(15)
  maxPenaltiesPerMonth    Int    @default(10)
  deductOnCheckout        Boolean @default(true)
  allowDoubleCheckin      Boolean @default(true)
  maxCheckinsPerDay       Int    @default(3)
  maxSwapsPerMonth        Int    @default(3)
  requireReasonSwap       Boolean @default(true)

  @@map("attendance_configs")
}

model ShiftTemplate {
  id        String   @id @default(cuid())
  name      String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shift_templates")
}

model ShiftRegistration {
  id         String   @id @default(cuid())
  employeeId String
  branchSlug String?
  week       String?
  shiftId    String?
  createdAt  DateTime @default(now())

  @@map("shift_registrations")
}

model Task {
  id               String   @id @default(cuid())
  title            String
  description      String?
  assignedTo       String?
  branchSlug       String?
  dueDate          String?
  status           String   @default("pending")
  sourceType       String?  @default("manager")
  assignedByName   String?
  shiftName        String?
  priority         String?  @default("normal")
  assignedToEmail  String?
  assignedToName   String?
  completedAt      String?
  requirePhoto     Boolean? @default(false)
  proofPhotoUrl    String?
  photoSubmittedBy String?
  photoSubmittedAt String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("tasks")
}

// Kho lưu trữ nhiệm vụ cũ — mirror trường Task, giữ id gốc để khôi phục.
// Ảnh minh chứng của nhiệm vụ archive không bị xóa.
model ArchivedTask {
  id               String   @id // id gốc của Task
  title            String
  description      String?
  assignedTo       String?
  branchSlug       String?
  dueDate          String?
  status           String
  sourceType       String?
  assignedByName   String?
  shiftName        String?
  priority         String?
  assignedToEmail  String?
  assignedToName   String?
  completedAt      String?
  requirePhoto     Boolean?
  proofPhotoUrl    String?
  photoSubmittedBy String?
  photoSubmittedAt String?
  createdAt        DateTime
  updatedAt        DateTime
  archivedAt       DateTime @default(now())
  archiveBatchId   String

  @@index([archivedAt])
  @@index([createdAt])
  @@map("archived_tasks")
}
