// Prisma schema — identity-service
// DB dùng chung Supabase Postgres (single-tenant, không có tenantId).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("staff") // admin | manager | staff
  roleTitle    String   @default("Nhân viên")
  branchSlug   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model DeviceSession {
  id         String   @id @default(cuid())
  userId     String
  deviceName String
  deviceType String   @default("desktop") // phone | tablet | desktop
  osInfo     String?
  location   String?  @default("Hà Nội, Việt Nam")
  ipAddress  String?
  lastActive String   @default("Đang hoạt động")
  isCurrent  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("device_sessions")
}

model RefreshToken {
  id              String   @id @default(cuid())
  token           String   @unique
  userId          String
  deviceSessionId String?
  expiresAt       DateTime?
  revoked         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([deviceSessionId])
  @@map("refresh_tokens")
}
