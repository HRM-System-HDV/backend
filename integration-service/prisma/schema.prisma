// Prisma schema — integration-service (Port 4005)
// Database hrm_integration trên Supabase Postgres riêng (single-tenant, không tenantId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id               String   @id @default(cuid())
  type             String   // leave | overtime | advance | shift_swap | work_supplement | other
  employeeId       String
  targetEmployeeId String?  // Nhân viên được nhờ làm thay / đổi ca (người phản hồi)
  branchSlug       String?
  title            String
  content          String
  attachmentUrl    String?
  status           String   @default("pending") // pending | approved | rejected
  reviewedBy       String?
  reviewNote       String?
  sourceShiftId    String?
  targetShiftId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("requests")
}

model Notification {
  id               String   @id @default(cuid())
  targetEmployeeId String?  // null = toàn hệ thống broadcast
  branchSlug       String?
  title            String
  body             String
  isRead           Boolean  @default(false)
  metadata         Json?
  requestType      String?
  shiftName        String?
  shiftDate        String?
  shiftTime        String?
  shiftHours       String?
  senderName       String?
  senderRole       String?
  senderPhone      String?
  createdAt        DateTime @default(now())

  @@map("notifications")
}

// Cài đặt nhận thông báo của từng người dùng (id = x-user-id do gateway xác thực).
model NotificationSetting {
  id             String   @id
  remindCheckIn  Boolean  @default(true)
  remindCheckOut Boolean  @default(true)
  remindShift    Boolean  @default(true)
  notifyTask     Boolean  @default(true)
  notifyLeave    Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@map("notification_settings")
}

model SoapGatewayConfig {
  id              String   @id @default("default")
  endpointUrl     String
  wsdlUrl         String
  serviceName     String
  port            Int      @default(8443)
  securityMode    String
  allowedIPs      String[]
  status          String   @default("unknown")
  lastPingTime    String?
  avgResponseTime String?
  certExpiry      String?
  channel         String?  @default("Gateway (REST/SOAP)")

  @@map("soap_gateway_configs")
}

model News {
  id        String   @id @default(cuid())
  title     String
  summary   String
  content   String
  date      String   // DD-MM-YYYY
  tag       String
  tagTone   String   @default("primary") // danger | warning | success | primary | gray
  pinned    Boolean  @default(false)
  branch    String   @default("Toàn công ty")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news")
}

model Regulation {
  id            String   @id @default(cuid())
  code          String
  title         String
  category      String
  summary       String
  content       String
  status        String   @default("hiệu lực") // hiệu lực | dự thảo | hết hiệu lực
  scope         String   @default("Toàn công ty")
  effectiveDate String   // DD-MM-YYYY
  expiryDate    String?
  version       String   @default("1.0")
  pinned        Boolean  @default(false)
  attachments   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("regulations")
}

model WifiConfig {
  id        String   @id @default(cuid())
  ssid      String
  bssid     String
  branch    String   // slug chi nhánh, ví dụ HN-1, HN-2
  status    String   @default("hoạt động") // hoạt động | vô hiệu hóa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wifi_configs")
}

// BacklogService tạo bảng này bằng raw SQL. Phải khai báo ở đây, nếu không
// `prisma db push` coi là bảng lạ và DROP mất nhật ký hoạt động.
model Backlog {
  id          String    @id
  timestamp   String
  userName    String    @map("user_name")
  userRole    String?   @default("staff") @map("user_role")
  action      String
  actionLabel String    @map("action_label")
  module      String
  targetName  String    @map("target_name")
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("backlogs")
}
