// Prisma schema — integration-service (Port 4005)
// Database hrm_integration: Postgres RIÊNG của service này (single-tenant, không tenantId).
//   - Môi trường local: container Postgres riêng do docker compose dựng ở cổng 5437
//     (xem DATABASE_URL trong .env: postgresql://...@localhost:5437/hrm_integration).
//   - Triển khai production: trỏ DATABASE_URL sang Postgres/Supabase riêng của service;
//     không dùng chung link với service khác (docs/RULES.md §6).
//
// Quy tắc định danh (chốt 12/11/2026):
//  - id: UUID (uuid(7)) cho mọi khóa chính và khóa ngoại.
//  - employeeId / branchId / sourceShiftId / targetShiftId / senderId / reviewedBy
//    là UUID do service sở hữu dữ liệu đó cấp — không có FK xuyên DB
//    (docs/RULES.md §6).
//  - KHÔNG có cột slug nào: chi nhánh được tham chiếu bằng branches.id.
//  - Ngày: DateTime @db.Date.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quy tắc nghiệp vụ; CHECK/index bổ sung nằm trong migration của service:
// - Ba loại Request (leave/advance/work_supplement) chỉ là mẫu đơn: duyệt không tự
//   sửa chấm công, lương hay thanh toán. Riêng shift_swap: duyệt/chấp nhận là lệnh
//   đổi lịch phân ca thật qua POST /api/shifts/swap nội bộ của work-service.
// - leave: bắt buộc hai ngày nghỉ, ngày kết thúc >= ngày bắt đầu.
// - advance: bắt buộc advanceAmount > 0.
// - shift_swap: bắt buộc sourceShiftId và targetEmployeeId; targetShiftId có thể
//   để trống nếu nhờ làm thay. Service kiểm tra quyền sở hữu và tính hợp lệ của ca.
//   Chụp shiftSwapMode khi tạo đơn để đổi cấu hình không đổi đơn đang chờ.
//   manager_approval: quản lý duyệt; mutual_acceptance: người được nhờ đồng ý/từ chối.
//   Người tạo đơn đã thể hiện sự đồng ý khi gửi; không giới hạn số lần đổi ca.
// - work_supplement: bắt buộc sourceShiftId và ít nhất một giờ đề nghị;
//   nếu có cả hai giờ thì requestedCheckOut >= requestedCheckIn.
//   Chỉ lưu/gửi/duyệt đơn; không tự ghi giờ vào/ra hoặc thay đổi lương khi duyệt.
// - Chỉ điền dữ liệu nghiệp vụ tương ứng với type; các trường loại khác để null.
// - approved/rejected: bắt buộc reviewedBy và reviewedAt, pending chưa có người xử lý.
// - Task cá nhân không có bước nhận việc; Request chỉ dùng cho các mẫu đơn đã khai báo.
// - Đơn đổi ca/làm thay: nhân viên đích đã có ca cùng ngày/ca mẫu thì không được chọn/gửi đơn.
// CHECK/index tương ứng đã khai báo trong migration 20261112230000_hrm_uuid_redesign.

model Request {
  id                String         @id @default(uuid(7)) @db.Uuid
  type              RequestType
  employeeId        String         @db.Uuid
  targetEmployeeId  String?        @db.Uuid // Nhân viên được nhờ làm thay / đổi ca
  branchId          String?        @db.Uuid // branches.id của organization-service
  title             String
  content           String
  attachmentUrl     String?
  // Nghỉ theo ngày, bao gồm cả hai đầu mút; đồ án chưa hỗ trợ nghỉ theo buổi.
  leaveStartDate    DateTime?      @db.Date
  leaveEndDate      DateTime?      @db.Date
  advanceAmount     Decimal?       @db.Decimal(15, 0)
  // Giờ vào/ra đề nghị bổ sung; sourceShiftId xác định ca cần bổ sung.
  requestedCheckIn  DateTime?      @db.Timestamptz
  requestedCheckOut DateTime?      @db.Timestamptz
  reviewedAt        DateTime?      @db.Timestamptz
  status            RequestStatus  @default(pending)
  // Người xử lý: admin/quản lý hoặc nhân viên đích trong chế độ mutual_acceptance.
  // users.id của identity-service + tên để hiển thị.
  reviewedBy        String?        @db.Uuid
  reviewedByName    String?
  reviewNote        String?
  sourceShiftId     String?        @db.Uuid // shifts.id của work-service
  targetShiftId     String?        @db.Uuid // shifts.id của work-service
  // Chỉ dùng cho shift_swap; các loại đơn khác để null.
  shiftSwapMode     ShiftSwapMode?
  createdAt         DateTime       @default(now())

  notifications Notification[]

  @@index([employeeId])
  @@index([targetEmployeeId])
  @@index([branchId])
  @@index([status])
  @@map("requests")
}

model Notification {
  id               String       @id @default(uuid(7)) @db.Uuid
  // Gửi chung = tạo một dòng cho từng người nhận, isRead độc lập.
  targetEmployeeId String       @db.Uuid
  // Phạm vi nội dung: chi nhánh cụ thể hoặc null = toàn thể; mỗi dòng vẫn một người nhận.
  branchId         String?      @db.Uuid
  title            String
  body             String
  isRead           Boolean      @default(false)
  // Dữ liệu phụ linh hoạt theo từng loại thông báo: vd
  // { shiftName, shiftDate, shiftTime, shiftHours, senderPhone }.
  metadata         Json?
  // Loại đơn liên quan — app dùng để điều hướng tới đúng màn hình.
  requestType      RequestType?
  // requests.id của đơn liên quan. Để RIÊNG là cột UUID có kiểu, không nhét vào
  // metadata: đây là con trỏ điều hướng (app bấm thông báo -> mở đúng đơn) và là
  // quan hệ thật, cần lọc được. Phần TỬ TẾ chỉ để hiển thị (shiftName/shiftDate/
  // shiftTime/shiftHours/senderPhone) thì mới nằm trong metadata.
  requestId        String?      @db.Uuid
  // Người gửi: users.id của identity-service + tên để hiển thị.
  senderId         String?      @db.Uuid
  senderName       String?
  createdAt        DateTime     @default(now())

  request Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([targetEmployeeId])
  @@index([branchId])
  @@index([requestId])
  @@index([targetEmployeeId, isRead, createdAt])
  @@map("notifications")
}

// Cài đặt nhận thông báo của từng người dùng.
// Khóa chính là user_id = users.id của identity-service (quan hệ 1:1).
model NotificationSetting {
  userId                   String  @id @db.Uuid
  checkInBefore1Hour       Boolean @default(true)
  checkInBefore30Min       Boolean @default(true)
  checkInBefore10Min       Boolean @default(true)
  checkOutBefore10Min      Boolean @default(true)
  missedCheckOutAfter10Min Boolean @default(true)
  missedCheckOutAfter30Min Boolean @default(true)
  missedCheckOutAfter1Hour Boolean @default(true)
  tabNotificationAlert     Boolean @default(true)
  soundEnabled             Boolean @default(true)
  vibrateEnabled           Boolean @default(true)

  @@map("notification_settings")
}

// Tối đa một dòng: migration 20261112230000_hrm_uuid_redesign tạo UNIQUE(isSingleton)
// kết hợp CHECK (isSingleton = true) — nên chỉ tồn tại DUY NHẤT một dòng cấu hình
// (dòng thứ hai, kể cả isSingleton = false, đều bị CHECK chặn).
// Service tạo cấu hình khi quản trị viên lưu; không tự sinh dữ liệu nghiệp vụ.
model SoapGatewayConfig {
  id              String    @id @default(uuid(7)) @db.Uuid
  isSingleton     Boolean   @unique @default(true)
  // URL bao gồm port nếu không dùng port mặc định của giao thức.
  endpointUrl     String
  wsdlUrl         String
  serviceName     String
  securityMode    String
  status          String    @default("unknown")
  lastPingTime    DateTime?
  avgResponseTime String?
  certExpiry      DateTime?

  @@map("soap_gateway_configs")
}

model News {
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String
  summary     String
  content     String
  publishDate DateTime @db.Date
  tag         String
  pinned      Boolean  @default(false)
  // branches.id — NULL nghĩa là đăng cho toàn công ty.
  branchId    String?  @db.Uuid
  // Người đăng: users.id + tên hiển thị.
  authorId    String?  @db.Uuid
  authorName  String?
  createdAt   DateTime @default(now())

  @@index([branchId])
  @@map("news")
}

model Regulation {
  id             String    @id @default(uuid(7)) @db.Uuid
  regulationCode String    @unique // QD-001
  title          String
  category       String
  summary        String
  content        String
  status         String    @default("hiệu lực") // hiệu lực | dự thảo | hết hiệu lực
  // branches.id — NULL nghĩa là áp dụng toàn công ty.
  scopeBranchId  String?   @db.Uuid
  effectiveDate  DateTime  @db.Date
  expiryDate     DateTime? @db.Date
  version        String    @default("1.0")
  pinned         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  // Tệp đính kèm thật (thay cho cột đếm "attachments" dạng số trước đây).
  files FileAsset[]

  @@index([scopeBranchId])
  @@map("regulations")
}

model WifiConfig {
  id        String   @id @default(uuid(7)) @db.Uuid
  ssid      String
  bssid     String
  // branches.id của organization-service (trước đây lưu slug chi nhánh).
  branchId  String   @db.Uuid
  status    String   @default("hoạt động") // hoạt động | vô hiệu hóa
  createdAt DateTime @default(now())

  @@index([branchId])
  @@map("wifi_configs")
}

// Nhật ký thao tác hệ thống.
model Backlog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @db.Uuid // users.id của identity-service
  userName   String   @map("user_name")
  // Không có default "staff": nhật ký thao tác ghi sai vai trò thì mất giá trị
  // bằng chứng. Không lấy được vai trò thì để trống, không bịa.
  userRole   String?  @map("user_role")
  action     String
  module     String
  entityType String   @map("entity_type") // employee, shift, request, ...
  entityId   String   @map("entity_id") // UUID hoặc khóa cấu hình dạng chuỗi
  targetName String   @map("target_name")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([module, entityType, entityId, createdAt])
  @@map("backlogs")
}

// Đăng ký file upload nội bộ — phục vụ đối soát ảnh mồ côi, không đọc xuyên DB.
// id = khóa UUID; public_id là đường dẫn dùng trong URL (vd "hrm/avatars/<uuid>").
model FileAsset {
  id           String      @id @default(uuid(7)) @db.Uuid
  publicId     String      @unique @map("public_id")
  folder       String
  storagePath  String      @map("storage_path") // tương đối trong STORAGE_DIR
  mime         String
  bytes        Int
  uploadedBy   String?     @db.Uuid // users.id của identity-service
  branchId     String?     @db.Uuid // branches.id của organization-service
  // Chủ sở hữu nghiệp vụ của tệp — FK THẬT trong cùng DB. Thay cho cột đếm
  // "attachments" dạng số trên regulations (số ảo, không có bảng nào gắn với nó):
  // tệp đính kèm là bản ghi thật, đếm lúc đọc.
  regulation   Regulation? @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  regulationId String?     @db.Uuid // regulations.id
  createdAt    DateTime    @default(now())
  deletedAt    DateTime? // xóa mềm để đối soát

  @@index([uploadedBy])
  @@index([branchId])
  @@index([regulationId])
  @@map("file_assets")
}

enum RequestType {
  leave
  advance
  shift_swap
  work_supplement
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum ShiftSwapMode {
  manager_approval
  mutual_acceptance
}
