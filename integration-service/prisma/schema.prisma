// Prisma schema — integration-service (Port 4005)
// Database hrm_integration trên Supabase Postgres riêng (single-tenant, không tenantId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id               String   @id @default(cuid())
  type             String   // leave | overtime | advance | shift_swap | work_supplement | other
  employeeId       String
  targetEmployeeId String?  // Nhân viên được nhờ làm thay / đổi ca (người phản hồi)
  branchSlug       String?
  title            String
  content          String
  attachmentUrl    String?
  status           String   @default("pending") // pending | approved | rejected
  reviewedBy       String?
  reviewNote       String?
  sourceShiftId    String?
  targetShiftId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("requests")
}

model Notification {
  id               String   @id @default(cuid())
  targetEmployeeId String?  // null = toàn hệ thống broadcast
  branchSlug       String?
  title            String
  body             String
  isRead           Boolean  @default(false)
  metadata         Json?
  requestType      String?
  shiftName        String?
  shiftDate        String?
  shiftTime        String?
  shiftHours       String?
  senderName       String?
  senderRole       String?
  senderPhone      String?
  createdAt        DateTime @default(now())

  @@map("notifications")
}

// Cài đặt nhận thông báo của từng người dùng (id = x-user-id do gateway xác thực).
// Khóa phải trùng khớp 10 switch trong mobile notif_settings.dart.
model NotificationSetting {
  id                     String   @id
  checkInBefore1Hour     Boolean  @default(true)
  checkInBefore30Min     Boolean  @default(true)
  checkInBefore10Min     Boolean  @default(true)
  checkOutBefore10Min    Boolean  @default(true)
  missedCheckOutAfter10Min Boolean @default(true)
  missedCheckOutAfter30Min Boolean @default(true)
  missedCheckOutAfter1Hour Boolean @default(true)
  tabNotificationAlert   Boolean  @default(true)
  soundEnabled           Boolean  @default(true)
  vibrateEnabled         Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  @@map("notification_settings")
}

model SoapGatewayConfig {
  id              String   @id @default("default")
  endpointUrl     String
  wsdlUrl         String
  serviceName     String
  port            Int      @default(8443)
  securityMode    String
  allowedIPs      String[]
  status          String   @default("unknown")
  lastPingTime    String?
  avgResponseTime String?
  certExpiry      String?
  channel         String?  @default("Gateway (REST/SOAP)")

  @@map("soap_gateway_configs")
}

model News {
  id        String   @id @default(cuid())
  title     String
  summary   String
  content   String
  date      String   // DD/MM/YYYY
  tag       String
  tagTone   String   @default("primary") // danger | warning | success | primary | gray
  pinned    Boolean  @default(false)
  branch    String   @default("Toàn công ty")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news")
}

model Regulation {
  id            String   @id @default(cuid())
  code          String
  title         String
  category      String
  summary       String
  content       String
  status        String   @default("hiệu lực") // hiệu lực | dự thảo | hết hiệu lực
  scope         String   @default("Toàn công ty")
  effectiveDate String   // DD/MM/YYYY
  expiryDate    String?
  version       String   @default("1.0")
  pinned        Boolean  @default(false)
  attachments   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("regulations")
}

model WifiConfig {
  id        String   @id @default(cuid())
  ssid      String
  bssid     String
  branch    String   // slug chi nhánh, ví dụ HN-1, HN-2
  status    String   @default("hoạt động") // hoạt động | vô hiệu hóa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wifi_configs")
}

// Backlog model chuẩn hóa Prisma ORM (P2-5c)
model Backlog {
  id          String    @id @default(cuid())
  timestamp   String
  userName    String    @map("user_name")
  userRole    String?   @default("staff") @map("user_role")
  action      String
  actionLabel String    @map("action_label")
  module      String
  targetName  String    @map("target_name")
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("backlogs")
}

// Đăng ký file upload nội bộ — phục vụ đối soát ảnh mồ côi, không đọc xuyên DB.
model FileAsset {
  id          String    @id // publicId, vd "hrm/avatars/<uuid>"
  folder      String
  storagePath String    // tương đối trong STORAGE_DIR, vd "hrm/avatars/<uuid>.jpg"
  mime        String
  bytes       Int
  width       Int       @default(0)
  height      Int       @default(0)
  uploadedBy  String?   // x-user-id do gateway xác thực
  createdAt   DateTime  @default(now())
  deletedAt   DateTime? // xóa mềm để đối soát

  @@map("file_assets")
}

// Kho lưu trữ đơn từ cũ — mirror trường Request, giữ id gốc để khôi phục.
model ArchivedRequest {
  id               String   @id // id gốc của Request
  type             String
  employeeId       String
  targetEmployeeId String?
  branchSlug       String?
  title            String
  content          String
  attachmentUrl    String?
  status           String
  reviewedBy       String?
  reviewNote       String?
  sourceShiftId    String?
  targetShiftId    String?
  createdAt        DateTime
  updatedAt        DateTime
  archivedAt       DateTime @default(now())
  archiveBatchId   String

  @@index([archivedAt])
  @@index([createdAt])
  @@map("archived_requests")
}

// Kho lưu trữ thông báo cũ — mirror trường Notification, giữ id gốc để khôi phục.
model ArchivedNotification {
  id               String   @id // id gốc của Notification
  targetEmployeeId String?
  branchSlug       String?
  title            String
  body             String
  isRead           Boolean
  metadata         Json?
  requestType      String?
  shiftName        String?
  shiftDate        String?
  shiftTime        String?
  shiftHours       String?
  senderName       String?
  senderRole       String?
  senderPhone      String?
  createdAt        DateTime
  archivedAt       DateTime @default(now())
  archiveBatchId   String

  @@index([archivedAt])
  @@index([createdAt])
  @@map("archived_notifications")
}
