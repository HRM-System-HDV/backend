PORT=4005
NODE_ENV=development
SERVICE_NAME=integration-service

# Mặc định local: 5 Postgres riêng do `docker compose up -d` dựng (mỗi service 1 container/port).
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/hrm_integration
# Nếu dùng Supabase: mỗi service phải dùng 1 project/link RIÊNG (cấm trỏ 2 service cùng 1 link).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true

PAYROLL_SERVICE_URL=http://localhost:4004
WORK_SERVICE_URL=http://localhost:4003
CORS_ORIGIN=http://localhost:3000

# Lưu trữ file nội bộ trên ổ đĩa (on-premise). Thư mục phải được backup cùng Postgres dump.
STORAGE_DIR=./storage
# Địa chỉ Gateway dùng ghép URL tuyệt đối trả về cho client: ${PUBLIC_BASE_URL}/api/files/<publicId>
PUBLIC_BASE_URL=http://localhost:4000
# Dung lượng ảnh tối đa sau giải mã base64 (byte), mặc định 10MB.
MAX_UPLOAD_BYTES=10485760
